{
    "name": "phoneda/tp-mqtt-collector",
    "description": "MQTT数据采集扩展包 for ThinkPHP 6",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "hndaheng",
            "email": "hndaheng@yeah.net"
        }
    ],
    "require": {
        "php": ">=7.2",
        "topthink/framework": "^5.0",
        "workerman/mqtt": "^1.0",
        "predis/predis": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "think\\mqtt\\": "src/"
        }
    },
    "extra": {
        "think": {
            "config": {
                "mqtt": "config/mqtt.php"
            }
        }
    }
}